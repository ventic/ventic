{
  "name": "ventic",
  "type": "module",
  "version": "0.8.1",
  "private": true,
  "packageManager": "bun@1.4.0",
  "description": "A media library and BitTorrent player for the desktop and Android TV",
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preinstall": "npx only-allow bun",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "logo": "tauri icon src-tauri/icons/icon.json && cp src-tauri/icons/icon.png public/logo.png",
    "i18n": "bun scripts/i18n.ts",
    "i18n:locales": "bun scripts/i18n-locales.ts",
    "check": "bun scripts/check.ts",
    "check:i18n": "bun scripts/i18n.ts --check",
    "check:iptv": "bun scripts/check-iptv.ts",
    "check:keys": "bun scripts/check-keys.ts",
    "check:types": "vue-tsc --noEmit",
    "check:android-downloads": "bun scripts/check-android-downloads.ts",
    "check:audio": "bun scripts/check-audio.ts",
    "check:calendar": "bun scripts/check-calendar.ts",
    "check:cast": "bun scripts/check-cast.ts",
    "check:boot": "bun scripts/check-boot.ts",
    "check:dpad": "bun scripts/check-dpad.ts",
    "check:downloads": "bun scripts/check-downloads.ts",
    "check:library": "bun scripts/check-library.ts",
    "check:macos": "bun scripts/check-macos.ts",
    "check:people": "bun scripts/check-people.ts",
    "check:perf": "bun scripts/check-perf.ts",
    "check:player": "bun scripts/check-player.ts",
    "check:play-notes": "bun scripts/check-play-notes.ts",
    "check:profiles": "bun scripts/check-profiles.ts",
    "check:ratings": "bun scripts/check-ratings.ts",
    "check:signing": "bun scripts/check-signing.ts",
    "check:torrents": "bun scripts/check-torrents.ts",
    "check:updates": "bun scripts/check-updates.ts",
    "check:supporters": "bun scripts/check-supporters.ts",
    "check:steps": "bun scripts/check-steps.ts",
    "check:sync": "bun scripts/check-sync.ts",
    "check:settings-search": "bun scripts/check-settings-search.ts",
    "check:subtitles": "bun scripts/check-subtitles.ts",
    "check:swipe": "bun scripts/check-swipe.ts",
    "check:theme": "bun scripts/check-theme.ts",
    "bump": "bumpp",
    "tauri": "tauri",
    "tauri:dev": "npx tsx scripts/build/tauri-dev.ts",
    "tauri:dev:android": "bun scripts/build/index.ts android-dev",
    "tauri:dev:tv": "bun scripts/build/index.ts android-dev --tv",
    "tauri:dev:phone": "bun scripts/build/index.ts android-dev --phone",
    "build": "bun scripts/build/index.ts",
    "build:windows": "bun scripts/build/index.ts windows",
    "build:android": "bun scripts/build/index.ts android",
    "build:android-ffmpeg": "bun scripts/build/android/ffmpeg.ts",
    "build:play": "bun scripts/build/index.ts play"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mdi/js": "^7.4.47",
    "@nuxt/icon": "^2.5.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0",
    "vuetify-nuxt-module": "1.0.0-rc.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/twemoji": "^1.2.5",
    "@nuxt/eslint": "^1.16.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@unocss/nuxt": "^66.11.0",
    "@unocss/preset-wind4": "^66.11.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "unocss": "^66.11.0",
    "vue-tsc": "^3.3.13"
  },
  "resolutions": {
    "typescript": "npm:typescript@~5.9.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "unrs-resolver"
  ]
}
