+    /// ventic: the other half of a stream window (`ManagedTorrent::set_stream_window`).
+    /// Forget every piece of a file being read that lies more than `behind` bytes behind
+    /// every reader and outside every reader's window ahead, so that a film streams
+    /// through a buffer instead of filling the disk.
+    ///
+    /// Forgetting is two steps, a call apart. The have bit goes now: from here on no reader
+    /// or peer is handed the piece, and a reader that wants it back waits for it like any
+    /// other missing piece. The bytes go on the next call, once a read or an upload that
+    /// passed its own have-check just before this has had seconds to finish with them.
+    ///
+    /// `edge` bytes at either end of a file are never forgotten — that is where a container
+    /// keeps its header and index, which a player reads again whenever it reopens the file.
+    /// Returns the bytes forgotten.
+    pub fn forget_outside(&self, behind: u64, edge: u64) -> anyhow::Result<u64> {
+        let ahead = self.streams.window();
+        if ahead == 0 {
+            return Ok(0);
+        }
+        let mut g = self.lock_write("forget_outside");
+        let locked = &mut **g;
+
+        // Last call's pieces — unless one has been fetched again since, or is being.
+        for piece in std::mem::take(&mut locked.forgotten) {
+            let pieces = locked.get_pieces()?;
+            if !pieces.is_inflight(piece) && pieces.chunks().is_piece_untouched(piece) {
+                self.discard_piece(piece);
+            }
+        }
+
+        // Read under the lock, which a reader takes to look at a have bit: none can move
+        // between this and the bits cleared below.
+        let readers = self.streams.positions();
+        if readers.is_empty() {
+            return Ok(0);
+        }
+
+        let lengths = &self.lengths;
+        let pieces = locked.get_pieces_mut()?;
+        let mut forgotten = Vec::new();
+        let mut bytes = 0;
+        for (file_id, fi) in self.metadata.file_infos.iter().enumerate() {
+            if fi.attrs.padding || !readers.iter().any(|(read, _)| *read == file_id) {
+                continue;
+            }
+            let keep_from = fi.offset_in_torrent + edge;
+            let keep_to = (fi.offset_in_torrent + fi.len).saturating_sub(edge);
+            for piece in fi
+                .piece_range
+                .clone()
+                .filter_map(|id| lengths.validate_piece_index(id))
+            {
+                let from = lengths.piece_offset(piece);
+                let len = u64::from(lengths.piece_length(piece));
+                // The file's own ends, and any piece it shares with a neighbour.
+                if from < keep_from || from + len > keep_to {
+                    continue;
+                }
+                let near = readers.iter().any(|(_, at)| {
+                    from + len > at.saturating_sub(behind) && from < at.saturating_add(ahead)
+                });
+                if near || !pieces.chunks().is_piece_have(piece) || pieces.is_inflight(piece) {
+                    continue;
+                }
+                pieces.forget_piece(piece, &self.metadata.file_infos);
+                forgotten.push(piece);
