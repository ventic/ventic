<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Downloading while the app is off screen. The engine runs in this very
         process, so a backgrounded app is a frozen engine unless a foreground
         service holds the process up; that service needs a notification to show
         (POST_NOTIFICATIONS, API 33+) and a partial wake lock to survive the
         screen going off. See Downloads.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Updating in place: the app downloads the new APK and opens the system
         installer on it (MainActivity's installUpdate). Without this the
         installer refuses to hear from us at all; with it, the user still has to
         confirm both the one-time "install unknown apps" switch and the install
         itself, and Android still refuses a package not signed with our key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support. Both are `required="false"` on purpose: the same APK
         installs on a phone, and a TV would refuse it if a touchscreen were
         required. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Predictive back, on every version that has it rather than only on the
         ones that turn it on by themselves. API 33 and 34 leave it off unless
         asked, API 35 and up switch it on regardless — and the difference is not
         cosmetic: with it on, BACK arrives through OnBackInvokedDispatcher and
         `onKeyDown` is never called, which is how the same APK could answer BACK
         correctly on an older TV box and close itself out of any screen on an
         Android 15 phone. Declared true so there is one path everywhere, and
         MainActivity answers it on the OnBackPressedDispatcher that both feed. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Ventic"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- ventic://<host>/<path> links, so a page can hand the app a source
                 URL to add. `singleTask` above means these arrive at the running
                 activity via onNewIntent rather than starting a second copy. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ventic" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <!-- `dataSync` is the type that fits a transfer, and from API 34 the type
             has to be declared here or startForeground throws. -->
        <service
          android:name=".DownloadService"
          android:foregroundServiceType="dataSync"
          android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
