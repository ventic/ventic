{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop",
	"description": "The tray icon, its menu and the in-app updater — all desktop-only",
	"platforms": [
		"linux",
		"macOS",
		"windows"
	],
	"windows": [
		"main",
		"secondary"
	],
	"permissions": [
		"core:menu:default",
		"core:tray:default",
		"updater:default",
		"process:allow-restart"
	]
}
